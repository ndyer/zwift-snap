#!/usr/bin/env bash
# Fake yad for the launcher tests. Records the dialogs that were opened in $TEST_DIR/yad.log.
# Error dialogs answer with the next exit code of $TEST_DIR/yad-answers (default: 1 = Quit).
set -u

mode="dialog"
for a in "$@"; do
    case "${a}" in
        --progress) mode="progress" ;;
        --text-info) mode="text-info" ;;
    esac
done

title=""
for a in "$@"; do
    case "${a}" in --title=*) title="${a#--title=}" ;; esac
done

if [[ ${mode} == "progress" ]]; then
    echo "progress-open" >> "${TEST_DIR}/yad.log"
    # same protocol as yad: lines starting with # are text, numbers are percentages
    while IFS= read -r line; do
        echo "progress: ${line}" >> "${TEST_DIR}/yad.log"
        if [[ ${line} =~ ^[0-9]+$ ]] && [[ ${line} -ge 100 ]]; then
            echo "progress-closed" >> "${TEST_DIR}/yad.log"
            exit 0
        fi
    done
    exit 0
fi

echo "${mode}: ${title}" >> "${TEST_DIR}/yad.log"
if [[ ${mode} == "text-info" ]]; then exit 0; fi

answers="${TEST_DIR}/yad-answers"
if [[ -s ${answers} ]]; then
    rc="$(head -n 1 "${answers}")"
    tail -n +2 "${answers}" > "${answers}.tmp" && mv "${answers}.tmp" "${answers}"
    exit "${rc}"
fi
exit 1
