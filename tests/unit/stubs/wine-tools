#!/usr/bin/env bash
# Stub for wine, wineboot, winetricks, winepath, wineserver, wget and gamemoderun.
# Installed under all of these names in the test bin directory, it behaves according to
# the variables FAKE_* and records every call in $TEST_DIR/calls.log.
set -u

cmd="$(basename "$0")"
echo "${cmd} $*" >> "${TEST_DIR}/calls.log"

install_dir="${ZWIFT_INSTALL_DIR}"

write_version() {
    mkdir -p "${install_dir}"
    echo "<Zwift sversion=\"$1 (1)\"/>" > "${install_dir}/Zwift_ver_cur.xml"
}

case "${cmd}" in
    wineboot)
        mkdir -p "${WINEPREFIX}/drive_c/users/tester"
        # like wine: the Documents folder of the wine user is a link to the real home directory
        mkdir -p "${TEST_DIR}/hostdocs"
        echo "keep" > "${TEST_DIR}/hostdocs/keep.txt"
        ln -sfn "${TEST_DIR}/hostdocs" "${WINEPREFIX}/drive_c/users/tester/Documents"
        # like a real prefix: drive_c grows at boot, so the install progress
        # sampler starts from a low percentage and rises during the install
        if [[ ${FAKE_WINETRICKS_GROW:-0} -eq 1 ]]; then
            dd if=/dev/zero of="${WINEPREFIX}/drive_c/windows/boot-chunk" bs=1k count=16 2> /dev/null
        fi
        ;;
    winetricks)
        if [[ ${FAKE_WINETRICKS_FAIL:-0} -eq 1 ]]; then
            echo "winetricks: failing as requested" >&2
            exit 1
        fi
        # grow the wine prefix like the real winetricks steps do, so the install
        # progress sampler (which measures drive_c) sees rising percentages. The
        # growth alone would be faster than one sampler interval, so stall a
        # moment per step like the real dotnet48 install does.
        if [[ ${FAKE_WINETRICKS_GROW:-0} -eq 1 ]]; then
            sleep "${FAKE_WINETRICKS_GROW_SLEEP:-1}"
            local_dir="${WINEPREFIX}/drive_c/windows/fake-install"
            mkdir -p "${local_dir}"
            dd if=/dev/zero of="${local_dir}/chunk.$(date +%s%N)" bs=1k count=16 2> /dev/null
        fi
        ;;
    wget)
        if [[ " $* " == *"Zwift_ver_cur.xml"* ]]; then
            if [[ -n ${FAKE_LATEST:-} ]]; then
                echo "<Zwift sversion=\"${FAKE_LATEST} (1)\" gbranch=\"x\"/>"
                exit 0
            fi
            exit 4 # no network
        fi
        if [[ " $* " == *"ZwiftSetup.exe"* ]]; then
            out="${2:-}"
            [[ ${1:-} == "-O" ]] && echo "setup" > "${out}"
            exit 0
        fi
        ;;
    wineserver)
        if [[ ${1:-} == "-k" ]]; then touch "${TEST_DIR}/launcher-done"; fi
        ;;
    winepath)
        echo "C:\\Program Files (x86)\\Zwift"
        ;;
    wine)
        case "${1:-}" in
            *ZwiftSetup.exe)
                if [[ ${FAKE_SETUP_FAIL:-0} -eq 1 ]]; then exit 1; fi
                # like Inno Setup: write the log to the /LOG=Z:\unix\path given
                for a in "$@"; do
                    if [[ ${a} == /LOG=Z:* ]]; then
                        log="${a#/LOG=Z:}"
                        echo "Fake Inno Setup log" > "${log//\\//}"
                    fi
                done
                # like the real installer: only the launcher and a placeholder version, the game
                # (ZwiftApp.exe) is downloaded by the launcher afterwards
                mkdir -p "${install_dir}"
                touch "${install_dir}/ZwiftLauncher.exe"
                echo '<Zwift version="0.0.0" GAME_URL="https://example.invalid" manifest="Zwift_0.0.0_manifest.xml"/>' \
                    > "${install_dir}/Zwift_ver_cur.xml"
                ;;
            start)
                if [[ " $* " == *"ZwiftLauncher.exe"* ]]; then rm -f "${TEST_DIR}/launcher-done"; fi
                if [[ " $* " == *"ZwiftLauncher.exe"* ]] && [[ -n ${FAKE_UPDATE_RESULT:-} ]]; then
                    # the launcher downloads or updates Zwift in the background
                    touch "${install_dir}/ZwiftApp.exe"
                    write_version "${FAKE_UPDATE_RESULT}"
                fi
                ;;
            tasklist)
                # the launcher and the game are running, the game stops after FAKE_GAME_POLLS checks
                image="${*: -1}"
                image="${image#IMAGENAME eq }"
                if [[ ${image} == "ZwiftApp.exe" ]]; then
                    n="$(cat "${TEST_DIR}/game-polls" 2> /dev/null || echo 0)"
                    echo $((n + 1)) > "${TEST_DIR}/game-polls"
                    if [[ ${n} -ge ${FAKE_GAME_POLLS:-2} ]]; then exit 0; fi
                    echo "Image Name: ZwiftApp.exe"
                    echo "PID: 4242"
                elif [[ ${image} == "ZwiftLauncher.exe" ]]; then
                    if [[ ${FAKE_LAUNCHER_STAYS:-0} -eq 1 ]] || [[ ! -f ${TEST_DIR}/launcher-done ]]; then
                        echo "Image Name: ZwiftLauncher.exe"
                        echo "PID: 4141"
                    fi
                fi
                ;;
            taskkill)
                if [[ " $* " == *"ZwiftLauncher.exe"* ]]; then touch "${TEST_DIR}/launcher-done"; fi
                ;;
        esac
        ;;
esac
exit 0
