#!/bin/bash
# setup-base hook of the zwift-snap-sdk SDK. Runs as root when the SDK is installed
# (workshop launch) and when its revision changes (workshop refresh), so the setup
# that used to be a workshop action now happens automatically on every fresh
# workshop. Everything here is idempotent, because a refresh can run it again.
set -uo pipefail

# All the build and test snaps, installed up front. snapcraft (classic, the destructive-mode
# builder) takes its own call; the rest are strict and go in one. snap install is idempotent:
# already-installed snaps are reported and skipped. pkgproxy caches apt and snap downloads for
# repeated builds (configured below; these one-off installs run before it and are not cached).
# mesa-2604 provides the gpu-2604 slot the zwift snap connects to; yarf drives the Robot
# Framework suite; gnome-46-2404 is yarf's gnome-platform content provider (its GTK, fontconfig,
# pixbuf and Python/GI runtime), normally pulled in with yarf but listed explicitly so it is
# documented and restored on refresh if removed to save disk; mir-test-tools provides the Mir
# compositor the launcher runs against. The content interfaces auto-connect once their providers
# are present (unlike process-control, connected below). The hook runs as root, so no sudo.
snap install snapcraft --classic
snap install pkgproxy mesa-2604 yarf gnome-46-2404 mir-test-tools

# Point snapd and apt at the pkgproxy cache so repeated builds skip the downloads; wait for the
# proxy daemon first.
for _ in $(seq 30); do
    pkgproxy.pkgproxyctl stats > /dev/null 2>&1 && break
    sleep 1
done
pkgproxy.pkgproxyctl stats > /dev/null
pkgproxy.pkgproxyctl setup snap | sh
# apt caches http:// sources only (plain-https sources still go direct)
pkgproxy.pkgproxyctl setup apt | sh
apt-get update && apt-get install -y shellcheck yamllint \
    bats bats-support bats-assert bats-file \
    bluez python3-venv python3-yaml

# yarf needs process-control for its OCR; connect it if still disconnected.
snap connections yarf 2>/dev/null \
    | awk '$2 == "yarf:process-control" && $3 == "-" { found=1 } END { exit !found }' \
    && snap connect yarf:process-control

# The Bluetooth plumbing test (tests/bluetooth.sh) needs a BlueZ to talk to,
# but the workshop has no Bluetooth hardware and bluetoothd's management
# socket needs privileges the container does not have. bluezoo
# (https://github.com/Samsung/BlueZoo) is a BlueZ D-Bus mock that runs
# entirely in user space and takes the place of bluetoothd: the test starts it
# as org.bluez on the system bus. It is not in the Ubuntu archive, so it comes
# from PyPI (not cached by pkgproxy); the venv is rebuilt only when missing.
# bluetoothd is masked so it cannot claim org.bluez, and the bluez package's
# D-Bus activation stub (Exec=/bin/false) is removed because it makes the
# first call to the unowned name fail with a confusing systemd error.
if ! command -v bluezoo > /dev/null 2>&1; then
    python3 -m venv /opt/bluezoo
    /opt/bluezoo/bin/pip install --quiet bluezoo==1.0.2
    ln -sf /opt/bluezoo/bin/bluezoo /usr/local/bin/bluezoo
fi
systemctl mask bluetooth.service
rm -f /usr/share/dbus-1/system-services/org.bluez.service
