#!/bin/bash
# setup-base hook of the zwift-snap-sdk SDK. Runs as root when the SDK is installed
# (workshop launch) and when its revision changes (workshop refresh), so the setup
# that used to be a workshop action now happens automatically on every fresh
# workshop. Everything here is idempotent, because a refresh can run it again.
set -uo pipefail

# snapcraft is installed from the snap store, destructive mode builds in this workshop.
# pkgproxy caches package downloads (apt, snaps) so repeated builds skip the download.
if ! snap list pkgproxy > /dev/null 2>&1; then
    snap install pkgproxy
fi
# wait for the proxy daemon before pointing apt and snapd at it
for _ in $(seq 30); do
    pkgproxy.pkgproxyctl stats > /dev/null 2>&1 && break
    sleep 1
done
pkgproxy.pkgproxyctl stats > /dev/null
# point snapd at the proxy first, so the snapcraft download below is cached too
pkgproxy.pkgproxyctl setup snap | sh
if ! snap list snapcraft > /dev/null 2>&1; then
    snap install snapcraft --classic
fi
# apt caches http:// sources only, hence the plain-http WineHQ url in snapcraft.yaml
pkgproxy.pkgproxyctl setup apt | sh
apt-get update && apt-get install -y shellcheck yamllint
